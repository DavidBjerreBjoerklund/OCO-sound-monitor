{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sound Monitor",
  "version": "0.2.0-alpha.5",
  "identifier": "dk.soundmonitor.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sound Monitor",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "linux": {
      "deb": {
        "files": {
          "/usr/share/metainfo/dk.soundmonitor.desktop.metainfo.xml": "metainfo/dk.soundmonitor.desktop.metainfo.xml"
        }
      },
      "rpm": {
        "files": {
          "/usr/share/metainfo/dk.soundmonitor.desktop.metainfo.xml": "metainfo/dk.soundmonitor.desktop.metainfo.xml"
        }
      }
    },
    "resources": {
      "../sound-monitor.ini": "sound-monitor.ini",
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_LICENSES.md": "THIRD_PARTY_LICENSES.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
